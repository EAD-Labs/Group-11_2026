# PostgreSQL connection string, e.g. from Render/Railway/Supabase
DATABASE_URL=postgres://user:password@host:5432/kanini_padhai

# Set to "false" only for local Postgres without SSL
PGSSL=true

# Long random string — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-this-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

NODE_ENV=development
PORT=4000

# Groq API Key for llama-3.3-70b-versatile analytics assistant
GROQ_API_KEY=gsk_your_groq_api_key_here
