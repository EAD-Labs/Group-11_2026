# PostgreSQL connection string, e.g. from Render/Railway/Supabase
DATABASE_URL=postgres://user:password@host:5432/kanini_padhai

# Set to "false" only for local Postgres without SSL
PGSSL=true

# Long random string — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-this-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

NODE_ENV=development
PORT=4000

# AI LLM Provider Configuration
# Set LLM_PROVIDER to 'gemini' or 'groq' (defaults to gemini if GEMINI_API_KEY is present)
LLM_PROVIDER=gemini

# Google Gemini API Suite (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key for open-source fallback (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth 2.0 Client Authentication (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Comma-separated list of emails with full ADMIN privileges (can view all schools, unmasked)
ADMIN_EMAILS=arjoe.basak@gmail.com
# Default role for OAuth users without teacher records: GUEST (masked) or ASHATEACHER
GOOGLE_OAUTH_DEFAULT_ROLE=GUEST

